{
    "name": "xflrpy.devcontainer",
    "image": "niksethi/xflrpy:base",
    "workspaceMount": "source=${localWorkspaceFolder},target=/xflrpy,type=bind",
    "workspaceFolder": "/xflrpy",
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash",
                "terminal.integrated.profiles.linux": { "bash": { "path": "/bin/bash" } }
            }
        }
    },
}